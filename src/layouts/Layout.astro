---
import "../styles/global.css";
import "../styles/print.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="manifest" href="/manifest.json" />
		<title>Javier Fernández Bellot - Portfolio</title>
		<meta
			name="description"
			content="Portfolio profesional de Javier Fernández Bellot. Desarrollador de Software HMI especializado en Python, Vue y sistemas embebidos."
		/>

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://javierfernandezbellot.com/" />
		<!-- Placeholder URL, user should update if different -->
		<meta
			property="og:title"
			content="Javier Fernández Bellot - Portfolio"
		/>
		<meta
			property="og:description"
			content="Portfolio profesional de Javier Fernández Bellot. Desarrollador de Software HMI especializado en Python, Vue y sistemas embebidos."
		/>
		<meta property="og:image" content="/icon-512.png" />

		<script is:inline>
			const getTheme = () => {
				if (
					typeof localStorage !== "undefined" &&
					localStorage.getItem("theme")
				) {
					return localStorage.getItem("theme");
				}
				return "light";
			};

			const theme = getTheme();
			if (theme === "light") {
				document.documentElement.classList.remove("dark");
			} else {
				document.documentElement.classList.add("dark");
			}
			window.localStorage.setItem("theme", theme);

			// Language auto-detection
			(function () {
				var supportedLangs = ["es", "en"];
				var stored = localStorage.getItem("lang");
				var lang =
					stored && supportedLangs.indexOf(stored) !== -1
						? stored
						: null;
				if (!lang) {
					var browserLang = (navigator.language || "")
						.split("-")[0]
						.toLowerCase();
					lang =
						supportedLangs.indexOf(browserLang) !== -1
							? browserLang
							: "es";
				}
				document.documentElement.lang = lang;
				localStorage.setItem("lang", lang);
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
