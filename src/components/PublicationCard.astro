---
import type { Publication } from "../data/cv-data";

interface Props {
    publication: Publication;
}

const { publication } = Astro.props;
---

<div
    class="p-6 rounded-2xl bg-card border border-border hover:shadow-lg transition-shadow"
>
    <div class="flex items-start justify-between gap-4">
        <div>
            <h3
                class="text-xl font-bold"
                data-i18n-es={publication.title.es}
                data-i18n-en={publication.title.en}
            >
                {publication.title.es}
            </h3>
            {
                publication.publisher && (
                    <p class="text-lg opacity-80 mt-1">
                        {publication.publisher}
                    </p>
                )
            }
        </div>

        {
            publication.url && (
                <a
                    href={publication.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-(--accent) hover:opacity-70 transition-all shrink-0 p-2 bg-(--accent)/10 rounded-full"
                    aria-label="Ver publicación"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <>
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="16" y1="13" x2="8" y2="13" />
                            <line x1="16" y1="17" x2="8" y2="17" />
                            <polyline points="10 9 9 9 8 9" />
                        </>
                    </svg>
                </a>
            )
        }
    </div>

    {
        publication.description && (
            <p
                class="text-muted-foreground leading-relaxed mt-4 italic border-l-2 border-border pl-4"
                data-i18n-es={publication.description.es}
                data-i18n-en={publication.description.en}
            >
                "{publication.description.es}"
            </p>
        )
    }

    {
        publication.date && (
            <p
                class="text-sm font-semibold text-(--accent) mt-4"
                data-i18n-es={publication.date.es}
                data-i18n-en={publication.date.en}
            >
                {publication.date.es}
            </p>
        )
    }
</div>
