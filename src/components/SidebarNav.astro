---
import type { NavSection } from "../data/cv-data";

interface Props {
    sections: NavSection[];
}

const { sections } = Astro.props;
---

<nav class="space-y-4">
    <h3
        class="text-sm font-semibold uppercase tracking-wider text-blue-500"
        data-i18n="nav.title"
    >
        Índice
    </h3>
    <ul class="space-y-2">
        {
            sections.map((section) => (
                <li>
                    <a
                        href={`#${section.id}`}
                        class="block p-2 rounded-lg hover:bg-card border border-transparent hover:border-border transition-all font-medium"
                        data-i18n-es={section.label.es}
                        data-i18n-en={section.label.en}
                    >
                        {section.label.es}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>
