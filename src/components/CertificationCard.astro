---
import type { Certification } from "../data/cv-data";

interface Props {
    cert: Certification;
}

const { cert } = Astro.props;
---

<div
    class="p-6 rounded-2xl bg-card border border-border hover:shadow-lg transition-shadow relative"
>
    {cert.url && (
        <a 
            href={cert.url} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="absolute top-6 right-6 text-blue-500 hover:text-blue-600 transition-colors"
            aria-label="Ver credencial"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </a>
    )}
    <h3
        class="text-xl font-bold pr-8"
        data-i18n-es={cert.name.es}
        data-i18n-en={cert.name.en}
    >
        {cert.name.es}
    </h3>
    <p class="text-lg opacity-80 mt-1">{cert.issuer}</p>
    
    <div class="flex items-center gap-4 mt-3">
        {cert.date && (
            <p
                class="text-sm text-blue-500 font-medium"
                data-i18n-es={cert.date.es}
                data-i18n-en={cert.date.en}
            >
                {cert.date.es}
            </p>
        )}
        {cert.credentialId && (
            <p class="text-sm text-muted-foreground font-mono bg-muted px-2 py-0.5 rounded">
                ID: {cert.credentialId}
            </p>
        )}
    </div>
</div>
