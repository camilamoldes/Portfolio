---
import type { SkillGroup } from "../data/cv-data";

interface Props {
    group: SkillGroup;
}

const { group } = Astro.props;
---

<div class="space-y-4">
    <h3
        class="text-xl font-bold"
        data-i18n-es={group.category.es}
        data-i18n-en={group.category.en}
    >
        {group.category.es}
    </h3>
    <div class="flex flex-wrap gap-2">
        {group.items.map((skill) => (
            <div class="px-4 py-2 rounded-xl bg-card border border-border text-sm font-medium hover:scale-105 active:scale-95 transition-all text-muted-foreground cursor-default flex items-center gap-2">
                {skill}
            </div>
        ))}
    </div>
</div>
