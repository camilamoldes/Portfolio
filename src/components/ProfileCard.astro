---
import { Image } from "astro:assets";
import photo from "../assets/photo.webp";
import type { ProfileData } from "../data/cv-data";

interface Props {
    profile: ProfileData;
}

const { profile } = Astro.props;
---

<div class="flex flex-col items-center text-center gap-4">
    <div class="relative">
        <Image
            src={photo}
            alt={profile.fullName}
            width={256}
            height={256}
            class="w-32 h-32 rounded-full object-cover border-2 border-accent shadow-lg"
        />
    </div>
    <div class="space-y-1">
        <h2 class="text-2xl font-bold">{profile.shortName}</h2>
        {
            profile.tagline && (
                <p
                    class="text-accent text-sm font-medium"
                    data-i18n-es={profile.tagline.es}
                    data-i18n-en={profile.tagline.en}
                >
                    {profile.tagline.es}
                </p>
            )
        }
        <p
            class="text-muted-foreground text-sm flex items-center justify-center gap-2"
            data-i18n-es={profile.location.es}
            data-i18n-en={profile.location.en}
        >
            {profile.location.es}
        </p>
    </div>
</div>
