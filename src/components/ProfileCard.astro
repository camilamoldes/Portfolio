---
import { Image } from "astro:assets";
import photo from "../assets/photo.webp";
import type { ProfileData } from "../data/cv-data";

interface Props {
    profile: ProfileData;
}

const { profile } = Astro.props;
---

<div class="flex flex-col items-center text-center gap-4">
    <div class="relative group">
        <div
            class="absolute -inset-1 bg-linear-to-r from-blue-600 to-cyan-500 rounded-full blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"
        >
        </div>
        <Image
            src={photo}
            alt={profile.fullName}
            class="relative w-32 h-32 rounded-full object-cover border-2 border-background shadow-xl"
        />
    </div>
    <div class="space-y-1">
        <h2 class="text-2xl font-bold">{profile.shortName}</h2>
        <p
            class="text-muted-foreground text-sm flex items-center justify-center gap-2"
            data-i18n-es={profile.location.es}
            data-i18n-en={profile.location.en}
        >
            {profile.location.es}
        </p>
    </div>
</div>
