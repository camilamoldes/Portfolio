---
import type { Project } from "../data/cv-data";

interface Props {
    project: Project;
}

const { project } = Astro.props;
---

<div
    class="p-6 rounded-2xl bg-card border border-border hover:shadow-lg transition-shadow relative"
>
    {
        project.url && (
            <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="absolute top-6 right-6 text-accent hover:text-accent-hover transition-colors"
                aria-label="Ver el proyecto"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <>
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        <polyline points="15 3 21 3 21 9" />
                        <line x1="10" y1="14" x2="21" y2="3" />
                    </>
                </svg>
            </a>
        )
    }

    <div class="flex items-center gap-3">
        <h3 class="text-xl font-bold">
            {project.name}
        </h3>
        {
            project.date && (
                <span
                    class="px-2.5 py-1 text-xs font-semibold bg-accent/10 text-accent rounded-full"
                    data-i18n-es={project.date.es}
                    data-i18n-en={project.date.en}
                >
                    {project.date.es}
                </span>
            )
        }
    </div>

    <p
        class="text-muted-foreground leading-relaxed mt-4"
        data-i18n-es={project.description.es}
        data-i18n-en={project.description.en}
    >
        {project.description.es}
    </p>

    {
        project.tech && project.tech.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-4 pt-4 border-t border-border/50">
                {project.tech.map((t) => (
                    <span class="text-xs font-mono px-2 py-1 bg-muted text-muted-foreground rounded-md">
                        {t}
                    </span>
                ))}
            </div>
        )
    }
</div>
