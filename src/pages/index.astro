---
import Layout from "../layouts/Layout.astro";
import ProfileCard from "../components/ProfileCard.astro";
import SocialLinks from "../components/SocialLinks.astro";
import SidebarNav from "../components/SidebarNav.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import EducationCard from "../components/EducationCard.astro";
import InterestTag from "../components/InterestTag.astro";
import LanguageCard from "../components/LanguageCard.astro";
import TextCard from "../components/TextCard.astro";
import SkillGroupCard from "../components/SkillGroupCard.astro";
import CertificationCard from "../components/CertificationCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import VolunteerItem from "../components/VolunteerItem.astro";
import AchievementCard from "../components/AchievementCard.astro";
import PublicationCard from "../components/PublicationCard.astro";
import ReferenceCard from "../components/ReferenceCard.astro";

import {
	profile,
	experiences,
	education,
	interests,
	languageSkills,
	texts,
	skills,
	certifications,
	projects,
	volunteer,
	achievements,
	publications,
	references,
} from "../data/cv-data";

import type { NavSection } from "../data/cv-data";

// ─── Generación dinámica del menú lateral ──────────────────────────────
const activeSections: NavSection[] = [
	{ id: "sobre-mi", label: { es: "Sobre mí", en: "About me" } },
	...(experiences.length > 0
		? [
				{
					id: "experiencia",
					label: { es: "Experiencia", en: "Experience" },
				},
			]
		: []),
	...(education.length > 0
		? [{ id: "formacion", label: { es: "Formación", en: "Education" } }]
		: []),
	...(skills.length > 0
		? [{ id: "habilidades", label: { es: "Habilidades", en: "Skills" } }]
		: []),
	...(certifications.length > 0
		? [
				{
					id: "certificaciones",
					label: { es: "Certificaciones", en: "Certifications" },
				},
			]
		: []),
	...(projects.length > 0
		? [{ id: "proyectos", label: { es: "Proyectos", en: "Projects" } }]
		: []),
	...(volunteer.length > 0
		? [
				{
					id: "voluntariado",
					label: { es: "Voluntariado", en: "Volunteering" },
				},
			]
		: []),
	...(achievements.length > 0
		? [{ id: "logros", label: { es: "Logros", en: "Achievements" } }]
		: []),
	...(publications.length > 0
		? [
				{
					id: "publicaciones",
					label: { es: "Publicaciones", en: "Publications" },
				},
			]
		: []),
	...(interests.length > 0
		? [
				{
					id: "intereses",
					label: {
						es: "Conocimientos e Intereses",
						en: "Knowledge & Interests",
					},
				},
			]
		: []),
	...(languageSkills.length > 0
		? [{ id: "idiomas", label: { es: "Idiomas", en: "Languages" } }]
		: []),
	...(references.length > 0
		? [
				{
					id: "referencias",
					label: { es: "Referencias", en: "References" },
				},
			]
		: []),
];
---

<Layout>
	<header
		class="fixed top-0 left-0 w-full z-20 backdrop-blur-md dark:bg-black/30 border-b border-border/50 px-6 py-4 flex justify-between items-center"
	>
		<div class="flex items-center gap-3">
			<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 100 100"
	width="36"
	height="36"
	fill="none"
	stroke-width="3"
	stroke-linecap="round"
	stroke-linejoin="round"
	class="text-foreground stroke-current"
	aria-label="CM Monogram"
>
	<!-- C -->
	<path d="
		M 42 24
		Q 25 24 25 50
		Q 25 76 42 76
	"/>

	<!-- M pegada a la C -->
	<path d="M 40 76 L 40 24" />
	<path d="M 40 24 L 54 52" />
	<path d="M 54 52 L 68 24" />
	<path d="M 68 24 L 68 76" />
</svg>
		</div>
		<div class="flex items-center gap-2 md:gap-3">
			<button
				id="lang-toggle"
				class="no-print p-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted/50 transition-all cursor-pointer text-sm font-semibold tracking-wide"
				aria-label="Toggle language"
			>
				EN
			</button>
			<button
				id="theme-toggle"
				class="no-print p-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted/50 transition-all cursor-pointer flex items-center justify-center"
				aria-label="Toggle dark mode"
			>
				<!-- Icono Luna (Modo Claro) -->
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="theme-icon-light"
					><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
					></path></svg
				>
				<!-- Icono Sol (Modo Oscuro) -->
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="theme-icon-dark"
					><circle cx="12" cy="12" r="5"></circle><line
						x1="12"
						y1="1"
						x2="12"
						y2="3"></line><line x1="12" y1="21" x2="12" y2="23"
					></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"
					></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
					></line><line x1="1" y1="12" x2="3" y2="12"></line><line
						x1="21"
						y1="12"
						x2="23"
						y2="12"></line><line
						x1="4.22"
						y1="19.78"
						x2="5.64"
						y2="18.36"></line><line
						x1="18.36"
						y1="5.64"
						x2="19.78"
						y2="4.22"></line></svg
				>
			</button>
			<div class="w-px h-5 bg-border/50 mx-1 hidden sm:block"></div>
			<button
				id="pdf-download"
				class="group no-print px-4 py-2 rounded-xl border border-border hover:border-foreground/30 hover:bg-muted/30 active:scale-95 transition-all cursor-pointer text-sm font-semibold tracking-wide flex items-center gap-2"
				aria-label="Download PDF"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="transition-transform group-hover:translate-y-0.5 text-muted-foreground group-hover:text-foreground"
					><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
					></path><polyline points="7 10 12 15 17 10"></polyline><line
						x1="12"
						x2="12"
						y1="15"
						y2="3"></line></svg
				>
				<span data-i18n="download.cv">Descargar CV</span>
			</button>
		</div>
	</header>

	<main class="flex flex-col md:flex-row w-full min-h-screen pt-16">
		<!-- Left Column: Sidebar -->
		<aside
			class="w-full md:w-1/3 max-w-[400px] min-w-[300px] border-r border-border/50 p-8 md:p-12 lg:p-16 flex flex-col gap-8 md:sticky md:top-16 md:h-[calc(100vh-64px)] overflow-y-auto"
		>
			<ProfileCard profile={profile} />
			<SocialLinks links={profile.links} />
			<SidebarNav sections={activeSections} />
		</aside>

		<!-- Right Column: Content -->
		<section
			id="content-column"
			class="flex-1 p-8 md:p-12 lg:p-16 pt-8 md:pt-12 lg:pt-16 pb-32 md:h-[calc(100vh-64px)] md:overflow-y-auto space-y-16 md:space-y-20 custom-scrollbar"
		>
			<!-- Sobre mi -->
			<section id="sobre-mi" class="reveal">
				<h2 class="text-4xl font-bold mb-8" data-i18n="about.title">
					Sobre mi
				</h2>
				<div class="space-y-12">
					{
						texts.map((text, i) => (
							<TextCard
								text={text}
								isLast={i === texts.length - 1}
							/>
						))
					}
				</div>
			</section>
			<!-- Experiencia -->
			<section id="experiencia" class="scroll-mt-24 reveal">
				<h2
					class="text-4xl font-bold mb-8"
					data-i18n="experience.title"
				>
					Experiencia
				</h2>
				<div class="space-y-12">
					{
						experiences.map((exp, i) => (
							<ExperienceItem
								experience={exp}
								isLast={i === experiences.length - 1}
							/>
						))
					}
				</div>
			</section>

			<!-- Formación -->
			<section id="formacion" class="scroll-mt-24 reveal">
				<h2 class="text-4xl font-bold mb-8" data-i18n="education.title">
					Formación
				</h2>
				<div class="grid grid-cols-1 gap-6">
					{education.map((item) => <EducationCard item={item} />)}
				</div>
			</section>

			<!-- Habilidades -->
			{
				skills.length > 0 && (
					<section id="habilidades" class="scroll-mt-24 reveal">
						<h2
							class="text-4xl font-bold mb-8"
							data-i18n="skills.title"
						>
							Habilidades
						</h2>
						<div class="space-y-6">
							{skills.map((group) => (
								<SkillGroupCard group={group} />
							))}
						</div>
					</section>
				)
			}

			<!-- Certificaciones -->
			{
				certifications.length > 0 && (
					<section id="certificaciones" class="scroll-mt-24 reveal">
						<h2
							class="text-4xl font-bold mb-8"
							data-i18n="certifications.title"
						>
							Certificaciones
						</h2>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							{certifications.map((cert) => (
								<CertificationCard cert={cert} />
							))}
						</div>
					</section>
				)
			}

			<!-- Proyectos -->
			{
				projects.length > 0 && (
					<section id="proyectos" class="scroll-mt-24 reveal">
						<h2
							class="text-4xl font-bold mb-8"
							data-i18n="projects.title"
						>
							Proyectos
						</h2>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							{projects.map((project) => (
								<ProjectCard project={project} />
							))}
						</div>
					</section>
				)
			}

			<!-- Voluntariado -->
			{
				volunteer.length > 0 && (
					<section id="voluntariado" class="scroll-mt-24 reveal">
						<h2
							class="text-4xl font-bold mb-8"
							data-i18n="volunteer.title"
						>
							Voluntariado
						</h2>
						<div class="space-y-12">
							{volunteer.map((vol, i) => (
								<VolunteerItem
									volunteer={vol}
									isLast={i === volunteer.length - 1}
								/>
							))}
						</div>
					</section>
				)
			}

			<!-- Logros -->
			{
				achievements.length > 0 && (
					<section id="logros" class="scroll-mt-24 reveal">
						<h2
							class="text-4xl font-bold mb-8"
							data-i18n="achievements.title"
						>
							Logros
						</h2>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							{achievements.map((achievement) => (
								<AchievementCard achievement={achievement} />
							))}
						</div>
					</section>
				)
			}

			<!-- Publicaciones -->
			{
				publications.length > 0 && (
					<section id="publicaciones" class="scroll-mt-24 reveal">
						<h2
							class="text-4xl font-bold mb-8"
							data-i18n="publications.title"
						>
							Publicaciones
						</h2>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							{publications.map((pub) => (
								<PublicationCard publication={pub} />
							))}
						</div>
					</section>
				)
			}

			<!-- Intereses -->
			<section id="intereses" class="scroll-mt-24 reveal">
				<h2 class="text-4xl font-bold mb-8" data-i18n="interests.title">
					Conocimientos e Intereses
				</h2>
				<div class="flex flex-wrap gap-3">
					{
						interests.map((interest) => (
							<InterestTag interest={interest} />
						))
					}
				</div>
			</section>

			<!-- Idiomas -->
			<section id="idiomas" class="scroll-mt-24 reveal">
				<h2 class="text-4xl font-bold mb-8" data-i18n="languages.title">
					Idiomas
				</h2>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
					{
						languageSkills.map((lang) => (
							<LanguageCard language={lang} />
						))
					}
				</div>
			</section>

			<!-- Referencias -->
			{
				references.length > 0 && (
					<section id="referencias" class="scroll-mt-24 reveal">
						<h2
							class="text-4xl font-bold mb-8"
							data-i18n="references.title"
						>
							Referencias
						</h2>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							{references.map((ref) => (
								<ReferenceCard reference={ref} />
							))}
						</div>
					</section>
				)
			}
		</section>
	</main>

	<script>
		import { detectLanguage, applyTranslations } from "../i18n/utils";
		import { languages, type Lang } from "../i18n/translations";
		import {
			prepareWithSegments,
			measureNaturalWidth,
		} from "@chenglou/pretext";

		// --- Initial Scroll Fix ---
		const contentColumn = document.getElementById("content-column");
		const scrollToTop = () => {
			if (window.innerWidth >= 768 && contentColumn) {
				contentColumn.scrollTo({ top: 0, behavior: "smooth" });
			} else {
				window.scrollTo({ top: 0, behavior: "smooth" });
			}
		};

		// Si es carga inicial
		if (!window.location.hash || window.location.hash === "#sobre-mi") {
			if (window.innerWidth >= 768 && contentColumn) {
				contentColumn.scrollTop = 0;
			} else {
				window.scrollTo(0, 0);
			}
		}

		// Interceptar clics en el menú para todas las secciones
		document.querySelectorAll('a[href^="#"]').forEach((link) => {
			link.addEventListener("click", (e) => {
				const id = link.getAttribute("href")?.substring(1);
				if (!id) return;

				const target = document.getElementById(id);
				if (target && window.innerWidth >= 768 && contentColumn) {
					e.preventDefault();
					history.pushState(null, "", `#${id}`);

					if (id === "sobre-mi") {
						contentColumn.scrollTo({ top: 0, behavior: "smooth" });
					} else {
						// Para las demás secciones, calculamos la distancia desde el top
						// del contenedor, restando un "margen de respiro" (~96px)
						// offsetTop es relativo al padre posicionado, por lo que en este
						// caso es directo desde el inicio del contentColumn.
						const topPos = target.offsetTop - 96; 
						contentColumn.scrollTo({
							top: topPos > 0 ? topPos : 0,
							behavior: "smooth",
						});
					}
				}
			});
		});

		// --- Setup Pretext width calculations for button text ---
		function stabilizeButtonWidth() {
			const pdfBtn = document.getElementById("pdf-download");
			const pdfSpan = pdfBtn?.querySelector("span");
			if (!pdfBtn || !pdfSpan) return;

			// Ensure fonts are ready before computing layout widths
			document.fonts.ready.then(() => {
				const fontStyle = window.getComputedStyle(pdfBtn);
				const font = `${fontStyle.fontWeight} ${fontStyle.fontSize} ${fontStyle.fontFamily}`;

				const esPrepared = prepareWithSegments("Descargar CV", font);
				const enPrepared = prepareWithSegments("Download CV", font);

				const maxTextWidth = Math.max(
					measureNaturalWidth(esPrepared),
					measureNaturalWidth(enPrepared),
				);

				// Apply calculated width directly to the span container so the button holds its size natively.
				pdfSpan.style.display = "inline-block";
				pdfSpan.style.width = `${Math.ceil(maxTextWidth)}px`;
				pdfSpan.style.textAlign = "left";
			});
		}

		// --- Theme toggle ---
		const themeToggle = document.getElementById("theme-toggle");
		themeToggle?.addEventListener("click", () => {
			const isDark = document.documentElement.classList.toggle("dark");
			localStorage.setItem("theme", isDark ? "dark" : "light");
		});

		// --- i18n ---
		let currentLang: Lang = detectLanguage();
		applyTranslations(currentLang);

		const langToggle = document.getElementById("lang-toggle");
		function updateLangButton() {
			if (langToggle) {
				const langKeys = Object.keys(languages) as Lang[];
				const nextLang =
					langKeys.find((l) => l !== currentLang) || "en";
				langToggle.textContent = nextLang.toUpperCase();
			}
		}
		updateLangButton();

		langToggle?.addEventListener("click", () => {
			const langKeys = Object.keys(languages) as Lang[];
			currentLang = langKeys.find((l) => l !== currentLang) || "en";
			applyTranslations(currentLang);
			updateLangButton();
		});

		// Call Pretext logic:
		stabilizeButtonWidth();

		// --- PDF download ---
		const pdfBtn = document.getElementById("pdf-download");
		pdfBtn?.addEventListener("click", () => {
			const pdfUrl = `/cv-${currentLang}.pdf`;
			const link = document.createElement("a");
			link.href = pdfUrl;
			link.download = `CV_Javier_Fernandez_${currentLang.toUpperCase()}.pdf`;
			document.body.appendChild(link);
			link.click();
			document.body.removeChild(link);
		});

		// --- Scroll Reveal Animations ---
		const observerOptions = {
			root: null,
			rootMargin: "0px",
			threshold: 0.15,
		};

		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add("active");
					// Optional: stop observing once it's revealed
					// observer.unobserve(entry.target);
				}
			});
		}, observerOptions);

		document.querySelectorAll(".reveal").forEach((el) => {
			observer.observe(el);
		});
	</script>
</Layout>

<style>
	/* Theme Icons Visibility */
	:global(html.dark) .theme-icon-light {
		display: none;
	}
	:global(html:not(.dark)) .theme-icon-dark {
		display: none;
	}

	html {
		scroll-behavior: smooth;
	}
	::-webkit-scrollbar {
		width: 8px;
	}
	::-webkit-scrollbar-track {
		background: transparent;
	}
	::-webkit-scrollbar-thumb {
		background: var(--border);
		border-radius: 10px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: var(--accent);
	}

	/* Reveal Animations */
	.reveal {
		opacity: 0;
		transform: translateY(30px);
		transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
		filter: blur(5px);
	}

	.reveal.active {
		opacity: 1;
		transform: translateY(0);
		filter: blur(0);
	}

	/* Optional: cascade effects for children */
	.reveal.active > * {
		animation: fadeIn 0.8s ease forwards;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
